# Nusxa oling: .env  — va qiymatlarni o'zingiz to'ldiring. .env git'ga TUSHMAYDI.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Panel manzili: kamida 24 belgi, taxmin qilib bo'lmaydigan. Yaratish:
#   python -c "import secrets; print('boshqaruv-' + secrets.token_urlsafe(24))"
PANEL_PATH=

# Next.js bilan umumiy kalitlar (qurilish_next/.env.local dagi bilan bir xil bo'lsin)
SITE_API_KEY=
NEXT_REVALIDATE_URL=http://127.0.0.1:3002/api/revalidate
NEXT_REVALIDATE_SECRET=
SITE_URL=http://localhost:3002

# Yangi murojaatlar shu botga keladi. Token — @BotFather dan; chat ID — botga /start yozib,
# https://api.telegram.org/bot<TOKEN>/getUpdates dagi "chat":{"id":...}. Bir nechta bo'lsa vergul bilan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Panelga kirish boti (qurilish_bot/.env dagi BOT_API_KEY bilan bir xil). Yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_API_KEY=
PANEL_LOGIN_URL=http://localhost:3002/panel/kirish
