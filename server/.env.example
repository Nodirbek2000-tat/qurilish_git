# Arxan — server sozlamalari. deploy.sh birinchi marta ishga tushganda shu fayldan .env yasaydi
# va maxfiy kalitlarni o'zi to'ldiradi. Siz faqat «QO'LDA» deb belgilanganlarni yozasiz.
# .env ni hech kimga bermang va git'ga qo'shmang.

# ---- QO'LDA ----
DOMAIN=arxan.uz
# SSL sertifikat (Let's Encrypt) uchun email: muddat haqida ogohlantirish shu yerga keladi
SSL_EMAIL=
# @BotFather bergan token (murojaatlar va panelga kirish shu bot orqali)
TELEGRAM_BOT_TOKEN=
# Murojaatlar keladigan chat ID (bir nechta bo'lsa vergul bilan)
TELEGRAM_CHAT_ID=
# Yandex xarita kaliti (bo'lmasa xarita oddiy ko'rinishda chiqadi)
NEXT_PUBLIC_YANDEX_MAPS_KEY=
PANEL_BOT=arxansorovbot

# ---- AVTOMATIK (deploy.sh yaratadi, o'zgartirmang) ----
DJANGO_SECRET_KEY=
PANEL_PATH=
SITE_API_KEY=
REVALIDATE_SECRET=
BOT_API_KEY=
